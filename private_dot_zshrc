# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
source $ZSH/oh-my-zsh.sh

# JiraCLI config
# export DEFAULT_JIRA_SERVER=
plugins=(git jirarc)

export JIRA=$HOME/go/bin
export PATH=$PATH:/usr/lib/go-1.23/bin
export PATH=$PATH:$JIRA
export PATH=$PATH:~/programs/jira/bin/
export JIRA_API_TOKEN=""
export JIRA_EDITOR="vim"


# General Exports
export PATH="$HOME/bash_custom:$PATH"

export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

export PATH="$HOME/bin/:$PATH"
export PATH=$PATH:$HOME/.bin

# Git General Alias
alias gmend="git add ./ && git commit --amend --no-edit && git push --force"
alias gpp='git pull --prune'

# AWSUME Config 
# alias awsume='. $(pyenv which awsume)'
