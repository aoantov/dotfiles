# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="agnoster"

# JiraCLI config
# export DEFAULT_JIRA_SERVER=
plugins=(git jirarc)

export JIRA=$HOME/go/bin
export PATH=$PATH:/usr/lib/go-1.20/bin
export PATH=$PATH:$JIRA
export PATH=$PATH:~/programs/jira/bin/
export JIRA_API_TOKEN=""
export JIRA_EDITOR="vim"

source $ZSH/oh-my-zsh.sh

export PATH="$HOME/bash_custom:$PATH"

export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# AWSUME Config 
alias awsume='. $(pyenv which awsume)'
export PATH="$HOME/.local/bin:$HOME/.pyenv/bin:$PATH"
alias awsume=". awsume"


export PATH="$HOME/bin/:$PATH"
export PATH=$PATH:$HOME/.bin

# General Alias
alias gmend="git add ./ && git commit --amend --no-edit && git push --force"
alias gpp='git pull --prune'

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
